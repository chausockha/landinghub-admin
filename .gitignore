# =============================================================================
# LandingHub — Workspace Root .gitignore
# =============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*

# Build, Bundle & TypeScript Cache
dist/
dist-ssr/
build/
out/
**/dist/
**/dist-ssr/
.vite/
**/.vite/
*.tsbuildinfo
**/*.tsbuildinfo
.eslintcache
.oxlintcache

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# External Skill Clone & Temporary Scratch Directories
/ui-ux-pro-max-skill/
tmp/
temp/
*.local
